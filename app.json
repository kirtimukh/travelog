{
  "expo": {
    "name": "Travelog",
    "slug": "Travelog",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "Travelog",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ubfoundry.travelog",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Travelog records your route while journeys are active, including in the background.",
          "locationWhenInUsePermission": "Travelog uses your location to show your path on the map.",
          "locationAlwaysPermission": "Allow background location so Travelog can continue recording your journey when the screen is off.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Travelog needs the microphone to record voice notes on a journey."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Travelog needs access to your photos to attach images to a journey.",
          "cameraPermission": "Travelog can use the camera to capture images for a journey."
        }
      ],
      "expo-file-system",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withAndroidAbiSplits.js"
    ]
  }
}
