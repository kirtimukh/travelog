{
  "expo": {
    "name": "Travelog",
    "slug": "Travelog",
    "version": "0.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "travelog",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1520"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1520"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ubfoundry.travelog",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Travelog records your route while journeys are active, including in the background.",
          "locationWhenInUsePermission": "Travelog uses your location to show your path on the map.",
          "locationAlwaysPermission": "Allow background location so Travelog can continue recording your journey when the screen is off.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Travelog needs the microphone to record voice notes on a journey."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Travelog needs access to your photos to attach images to a journey.",
          "cameraPermission": "Travelog can use the camera to capture images for a journey."
        }
      ],
      "expo-file-system",
      [
        "@sentry/react-native/expo",
        {
          "organization": "ubworks",
          "project": "travelog",
          "url": "https://de.sentry.io/",
          "useNativeInit": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "reactNativeArchitectures": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withAndroidAbiSplits.js",
      "./plugins/withExpoProguardRules.js",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "travelog",
          "organization": "ubworks"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.ubfoundry.travelog"
    }
  }
}
