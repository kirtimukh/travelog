{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "expo": "^55.0.15",
    "expo-asset": "^55.0.15",
    "expo-audio": "~55.0.13",
    "expo-battery": "~55.0.13",
    "expo-build-properties": "^55.0.13",
    "expo-constants": "~55.0.14",
    "expo-dev-client": "^55.0.27",
    "expo-file-system": "~55.0.16",
    "expo-image-picker": "~55.0.18",
    "expo-linking": "~55.0.13",
    "expo-location": "~55.1.8",
    "expo-router": "~55.0.12",
    "expo-splash-screen": "~55.0.18",
    "expo-sqlite": "^55.0.15",
    "expo-status-bar": "^55.0.5",
    "expo-task-manager": "~55.0.14",
    "nativewind": "^4.2.3",
    "react": "^19.2.5",
    "react-native": "0.83.4",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.4",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.5",
    "babel-preset-expo": "^55.0.17",
    "jest": "^30.2.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "clearMocks": true,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
